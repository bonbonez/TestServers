[Unit]
Description=Test Servers - config/admin API (DUMMY / test-only)
After=network.target
PartOf=test-servers.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=@APP_DIR@/.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=TLS=false
ExecStart=/usr/bin/env node apps/config-server/dist/index.js
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
