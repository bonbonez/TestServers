[Unit]
Description=Test Servers - config/admin API (DUMMY / test-only)
After=network.target
PartOf=test-servers.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
# Generated by deploy/install.sh from .env: inline comments stripped and deploy
# overrides applied. systemd keeps trailing '# ...' as part of a value and lets
# EnvironmentFile override Environment=, so .env must not be used directly here.
# Optional (leading '-'): without it the Environment= defaults below still apply.
EnvironmentFile=-@APP_DIR@/.env.systemd
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=TLS=false
# Keep the SQLite credential store outside the repo: ProtectSystem=full makes /usr
# read-only, and the repo may live there. %S is /var/lib for system services.
StateDirectory=test-servers
Environment=CREDS_DB_PATH=%S/test-servers/creds.db
ExecStart=/usr/bin/env node apps/config-server/dist/index.js
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
