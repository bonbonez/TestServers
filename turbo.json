{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "envMode": "loose",
  "globalEnv": [
    "NODE_ENV",
    "TLS",
    "VITE_BASE",
    "VITE_CONFIG_SERVER_URL",
    "VITE_CONFIG_SERVER_TARGET",
    "VITE_OAUTH_SERVER_URL",
    "VITE_OAUTH_SERVER_TARGET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
