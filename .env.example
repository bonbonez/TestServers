# All values here are DUMMY dev placeholders — safe to commit.
# Copy to .env and adjust locally. NEVER replace with real secrets.
#
# The credential values below (tokens, TTLs, audience, redirect URIs, API creds) SEED the
# shared SQLite store on first run only. After that the store (edited via the admin console
# at config-server/admin-web) is the source of truth; delete .data/creds.db to re-seed.
#
# Under systemd, deploy/install.sh derives .env.systemd from this file (inline comments are
# stripped — systemd would keep them as part of the value) and the store lives at
# /var/lib/test-servers/creds.db. See docs/DEPLOY.md.

# ---- shared ----
HOST=127.0.0.1                       # bind address; set 0.0.0.0 only intentionally (warns)
NODE_ENV=development
TLS=true                             # serve HTTPS (self-signed dev cert); false = plain HTTP
# TLS_CERT=.keys/cert.pem            # explicit cert instead of the generated self-signed one
# TLS_KEY=.keys/key.pem
LOG_LEVEL=info                        # debug | info | warn | error
# NO_COLOR=1                         # disable colored logs even on a TTY
# CREDS_DB_PATH=.data/creds.db       # override the shared credential store location

# ---- mcp-server ----
MCP_PORT=7100
MCP_BEARER_TOKEN=dev-mcp-bearer-token-abc123          # accepted by /mcp/bearer (dev-only)
# Defaults follow TLS (https when TLS=true, http when TLS=false). Uncomment to pin.
# MCP_OAUTH_JWKS_URL=https://localhost:7200/.well-known/jwks.json
MCP_OAUTH_AUDIENCE=mcp-test                        # optional aud check
MCP_OAUTH_REQUIRED_SCOPE=read                          # optional scope check

# ---- oauth-server ----
OAUTH_PORT=7200
# OAUTH_ISSUER=https://localhost:7200          # defaults follow TLS; uncomment to pin
ACCESS_TOKEN_TTL_SECONDS=120                            # short so refresh path runs
REFRESH_TOKEN_TTL_SECONDS=86400
AUTH_CODE_TTL_SECONDS=300
ACCESS_TOKEN_AUDIENCE=mcp-test                     # aud claim minted into access tokens
# In dev, /authorize redirects here (the React login app). In prod, oauth-server serves
# oauth-login-web/dist instead.
# OAUTH_LOGIN_WEB_URL=https://localhost:7201   # defaults follow TLS; uncomment to pin
# Allow-list of redirect URIs the authorization-code flow will honour (comma-separated).
# Add the exact origin you run the client on.
OAUTH_ALLOWED_REDIRECT_URIS=https://localhost:8090/integration-accounts/mcp/oauth/callback,https://localhost:8443/integration-accounts/mcp/oauth/callback,http://localhost:5173/integration-accounts/mcp/oauth/callback
# Dummy static credentials for the protected /resource/* API (Bearer / Basic testing).
API_STATIC_BEARER=dev-api-static-bearer-token
API_BASIC_USER=api-basic-user
API_BASIC_PASS=dev-api-basic-pass

# ---- oauth-login-web ----
# Dev serves over HTTPS (self-signed) and proxies /oauth to oauth-server, so consent is
# POSTed same-origin by default — no VITE_OAUTH_SERVER_URL needed. Set it only to POST to
# an absolute oauth-server origin instead of the proxy.
# VITE_OAUTH_SERVER_URL=
# VITE_OAUTH_SERVER_TARGET=https://localhost:7200       # dev proxy upstream for /oauth

# ---- config-server (admin API for the credential store) ----
CONFIG_PORT=7300

# ---- admin-web (credentials console) ----
# Dev serves over HTTPS (self-signed) and proxies /api to config-server, so the console
# calls its API same-origin by default — no VITE_CONFIG_SERVER_URL needed. Set it only to
# point the console at an absolute config-server origin instead of the proxy.
# VITE_CONFIG_SERVER_URL=
# VITE_CONFIG_SERVER_TARGET=https://localhost:7300     # dev proxy upstream for /api
